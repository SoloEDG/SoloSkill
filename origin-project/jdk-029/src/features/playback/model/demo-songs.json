  {
    "id": "dawn",
    "title": "清晨来信",
    "artist": "夜航原声",
    "bpm": 84,
    "key": "G 大调",
    "duration": 45.714285714285715,
    "audio": "/media/dawn.wav",
    "cover": "/media/dawn.jpg",
    "lines": [
      {
        "id": "dawn-1",
        "text": "把清晨寄给远方",
        "start": 2.85714,
        "end": 7.5
      },
      {
        "id": "dawn-2",
        "text": "云从山的背面来",
        "start": 7.85714,
        "end": 12.5
      },
      {
        "id": "dawn-3",
        "text": "沿着慢下来的光",
        "start": 12.85714,
        "end": 17.5
      },
      {
        "id": "dawn-4",
        "text": "看见醒来的窗台",
        "start": 17.85714,
        "end": 22.5
      },
      {
        "id": "dawn-5",
        "text": "等回信落在手上",
        "start": 22.85714,
        "end": 27.5
      },
      {
        "id": "dawn-6",
        "text": "把昨天轻轻打开",
        "start": 27.85714,
        "end": 32.5
      },
      {
        "id": "dawn-7",
        "text": "那些走散的回响",
        "start": 32.85714,
        "end": 37.5
      },
      {
        "id": "dawn-8",
        "text": "陪着我们向前",
        "start": 37.85714,
        "end": 42.5
      }
    ],
