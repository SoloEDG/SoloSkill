[
  {
    "id": "tide",
    "title": "潮汐之后",
    "artist": "夜航原声",
    "bpm": 90,
    "key": "C 大调",
    "duration": 42.666666666666664,
    "audio": "/media/tide.wav",
    "cover": "/media/tide.jpg",
    "lines": [
      {
        "id": "tide-1",
        "text": "把夜色折进衣袖",
        "start": 2.66667,
        "end": 7.0
      },
      {
        "id": "tide-2",
        "text": "听见远处的海风",
        "start": 7.33333,
        "end": 11.66667
      },
      {
        "id": "tide-3",
        "text": "沿着褪色的街口",
        "start": 12.0,
        "end": 16.33333
      },
      {
        "id": "tide-4",
        "text": "走过每一次等候",
        "start": 16.66667,
        "end": 21.0
      },
      {
        "id": "tide-5",
        "text": "如果星光还能停留",
        "start": 21.33333,
        "end": 25.66667
      },
      {
        "id": "tide-6",
        "text": "就让余音慢慢漂流",
        "start": 26.0,
        "end": 30.33333
      },
      {
        "id": "tide-7",
        "text": "等到潮汐退去以后",
        "start": 30.66667,
        "end": 35.0
      },
      {
        "id": "tide-8",
        "text": "我再向天亮挥手",
        "start": 35.33333,
        "end": 39.66667
      }
    ],
