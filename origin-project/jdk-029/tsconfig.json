{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "useDefineForClassFields": true,
    "strict": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"], "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
